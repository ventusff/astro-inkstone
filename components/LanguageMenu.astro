---
/**
 * LanguageMenu — a site's one language control for its nav bar.
 *
 * Each row names a language in itself (its autonym) — a reader who cannot
 * read the current page's language still finds their own — and, as a second
 * line, in `glossLang`: English by default, or the page's own language when
 * the site passes it. The second line is the item's `gloss` when the site
 * supplies one, otherwise Intl.DisplayNames' name, left out where it
 * repeats the autonym. The site supplies every row, including where it
 * leads — usually this page's twin in that language, or that language's
 * landing page when no twin exists — so routing stays site-owned.
 *
 * A native popover: the trigger works without JavaScript (the panel then
 * centers, the UA's default popover placement); the script only anchors the
 * panel under its trigger, inside the viewport. Light dismiss and Esc come
 * from the popover itself. Up to six languages list in one column, more in
 * two.
 *
 * Two ways a row acts. Without `setter`, each row is a link to `href` —
 * a site whose address carries the language. With `setter`, the language is
 * a property of the reader: each row is a form that POSTs the code (field
 * `lang`) and the page the reader is on (field `return`) to `setter.action`,
 * which records the reader's language and sends them back; the site then
 * serves every page in it.
 *
 * A row may carry the state of this page in that language — queued, being
 * translated, published and about to go live, partly translated, not yet
 * written, failed (lib/language-status.ts) — shown as a dot and a line of
 * text under the name; while a newer version of any language is on its way
 * (queued, being translated or published), the trigger carries a slowly
 * pulsing dot (still under reduced motion), and a failure a steady one. The state is data the site
 * supplies; a script that learns a newer state sets `data-lang-status` and
 * the status text on the row, and the row, the trigger's dot and its
 * accessible name follow.
 *
 * With `sync`, the panel ends in the site's "sync translations now" action
 * (TranslationSync): the button, the progress of the sync it started and
 * when the next automatic sync runs, read from `sync.endpoint` each time the
 * panel opens, in the endpoint's own words.
 *
 * Presentational like every wiki component: second-tier tokens only, every
 * label a prop, and the panel carries `data-probe-open` so the render probes
 * sample it open.
 */
import { languageSignal, type LanguageStatus } from '../lib/language-status.ts';
import TranslationSync from './TranslationSync.astro';

export type { LanguageStatus };

export interface LanguageMenuItem {
  /** language code — what a setter records */
  code: string;
  /** the language's name in itself */
  label: string;
  /** value for the row's `lang` and `hreflang` */
  htmlLang: string;
  /** where choosing this language leads */
  href: string;
  /** the language's name in `glossLang`; default Intl.DisplayNames' name */
  gloss?: string | undefined;
  /** this page's state in this language, with its words in the page's language */
  status?: { kind: LanguageStatus; label: string } | undefined;
}

interface Props {
  items: LanguageMenuItem[];
  /** code of the page's current language */
  current: string;
  /** accessible name of the control and its panel, e.g. "Languages" */
  label: string;
  /** popover id — unique per page; change it only to mount two menus */
  id?: string;
  /** where a chosen language is recorded for the reader (see above) */
  setter?: { action: string };
  /** BCP 47 tag of the language the rows' second line is written in. Default 'en' */
  glossLang?: string;
  /** the site's "sync translations now" endpoint (lib/translation-sync.ts) */
  sync?: { endpoint: string } | undefined;
}

const { items, current, label, id = 'lang-menu', setter, glossLang = 'en', sync } = Astro.props;
const here = items.find((i) => i.code === current);
if (!here) throw new Error(`LanguageMenu: current language "${current}" is not among the items`);
const cols = items.length > 6 ? 2 : 1;
// each language's name in glossLang: the rows' second line
const names = new Intl.DisplayNames([glossLang], { type: 'language' });
const gloss = (item: LanguageMenuItem): string | undefined => {
  if (item.gloss !== undefined) return item.gloss;
  const name = names.of(item.code);
  return name && name !== item.label ? name : undefined;
};
const signal = languageSignal(items.map((i) => i.status?.kind));
const signalText = items
  .filter((i) => i.status)
  .map((i) => `${i.label}: ${i.status!.label}`)
  .join('; ');
const name = `${label} · ${here.label}`;
---

<button
  class="lang-btn"
  type="button"
  popovertarget={id}
  aria-label={signalText ? `${name} · ${signalText}` : name}
  title={label}
  data-lang-trigger
  data-lang-name={name}
  data-lang-signal={signal}
>
  {/* the 文/A mark: translation, not a flag — flags name countries, not languages */}
  <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
    <path d="M3 5h7M6.5 3v2M9.3 5c-.8 2.8-2.9 5.2-5.8 6.7M4.6 7.4c1.2 2.3 3.2 4 5.6 4.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M11.5 16.5 14.6 8l3.1 8.5M12.6 13.8h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="cur" lang={here.htmlLang}>{here.label}</span>
  <span class="signal" aria-hidden="true"></span>
  <svg class="chev" viewBox="0 0 10 10" width="8" height="8" aria-hidden="true">
    <path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<div
  class="lang-pop"
  id={id}
  popover
  data-probe-open
  data-cols={cols}
>
  <nav aria-label={label}>
    <ul>
      {
        items.map((item) =>
          item.code === current ? (
            <li data-lang-code={item.code} data-lang-status={item.status?.kind}>
              <span class="row here" aria-current="true" lang={item.htmlLang}>
                <span class="name">{item.label}</span>
                {gloss(item) && (
                  <span class="alt" lang={glossLang}>
                    {gloss(item)}
                  </span>
                )}
                <span class="state" lang={here.htmlLang}>{item.status?.label}</span>
                <svg class="check" viewBox="0 0 14 14" width="13" height="13" aria-hidden="true">
                  <path d="M2.5 7.5 6 11l5.5-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </li>
          ) : (
            <li data-lang-code={item.code} data-lang-status={item.status?.kind}>
              {setter ? (
                <form class="set" method="post" action={setter.action}>
                  <input type="hidden" name="lang" value={item.code} />
                  <input type="hidden" name="return" value={item.href} data-return />
                  <button class="row" type="submit" lang={item.htmlLang}>
                    <span class="name">{item.label}</span>
                    {gloss(item) && (
                      <span class="alt" lang={glossLang}>
                        {gloss(item)}
                      </span>
                    )}
                    <span class="state" lang={here.htmlLang}>{item.status?.label}</span>
                  </button>
                </form>
              ) : (
                <a class="row" href={item.href} hreflang={item.htmlLang} lang={item.htmlLang}>
                  <span class="name">{item.label}</span>
                  {gloss(item) && (
                    <span class="alt" lang={glossLang}>
                      {gloss(item)}
                    </span>
                  )}
                  <span class="state" lang={here.htmlLang}>{item.status?.label}</span>
                </a>
              )}
            </li>
          ),
        )
      }
    </ul>
  </nav>
  {
    sync && (
      <div class="sync">
        <TranslationSync endpoint={sync.endpoint} lang={here.htmlLang} />
      </div>
    )
  }
</div>

<script>
  import { languageSignal } from 'astro-inkstone/lib/language-status';

  // Anchor each panel under its trigger (top-layer popovers position like
  // fixed elements; without this the UA centers the panel — an acceptable
  // no-JS fallback, not the design). The panel hangs from the trigger's right
  // edge and never leaves the viewport: where the trigger sits too far left
  // for the panel's width (a phone), the panel keeps an 8px inset from the
  // viewport's left edge instead. Its width is a computed length, readable
  // while the panel is still closed.
  const INSET = 8;
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-lang-trigger]')) {
    const pop = document.getElementById(btn.getAttribute('popovertarget') ?? '');
    if (!pop) continue;
    pop.addEventListener('beforetoggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open') return;
      const r = btn.getBoundingClientRect();
      const width = parseFloat(getComputedStyle(pop).width) || 0;
      const underTrigger = Math.round(window.innerWidth - r.right);
      const fitsLeftEdge = Math.round(window.innerWidth - INSET - width);
      pop.style.top = `${Math.round(r.bottom + INSET)}px`;
      pop.style.right = `${Math.max(INSET, Math.min(underTrigger, fitsLeftEdge))}px`;
      pop.style.left = 'auto';
      pop.style.bottom = 'auto';
      pop.style.margin = '0';
    });

    // A recorded choice returns the reader to the page they are on, as it
    // is when they choose.
    pop.addEventListener('submit', (e) => {
      const input = (e.target as HTMLElement).querySelector<HTMLInputElement>('input[data-return]');
      if (input) input.value = location.href;
    });

    // The trigger's dot and accessible name follow the rows' states.
    new MutationObserver(() => {
      const rows = [...pop.querySelectorAll<HTMLElement>('li[data-lang-status]')];
      const signal = languageSignal(rows.map((row) => row.dataset.langStatus));
      if (signal) btn.dataset.langSignal = signal;
      else delete btn.dataset.langSignal;
      const text = rows
        .map((row) => `${row.querySelector('.name')?.textContent ?? ''}: ${row.querySelector('.state')?.textContent ?? ''}`)
        .join('; ');
      const name = btn.dataset.langName ?? '';
      btn.setAttribute('aria-label', text ? `${name} · ${text}` : name);
    }).observe(pop, {
      subtree: true,
      childList: true,
      characterData: true,
      attributes: true,
      attributeFilter: ['data-lang-status'],
    });
  }
</script>

<style>
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 4px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: none;
    color: var(--color-ink-soft);
    font: 500 11.5px/1 var(--font-ui);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .lang-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .chev {
    opacity: 0.7;
  }

  .lang-pop {
    /* top-layer panel; the inline script anchors it under the trigger */
    width: min(92vw, 220px);
    max-height: min(72vh, 560px);
    overflow-y: auto;
    padding: 6px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-bg-card);
    color: var(--color-ink);
    box-shadow: 0 14px 40px color-mix(in srgb, var(--color-ink) 14%, transparent);
  }
  .lang-pop[data-cols='2'] {
    width: min(92vw, 400px);
  }
  .lang-pop ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang-pop[data-cols='2'] ul {
    grid-template-columns: 1fr 1fr;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    align-items: center;
    column-gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }
  .set {
    display: contents;
  }
  button.row {
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  a.row:hover,
  button.row:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .name {
    grid-column: 1;
    font: 550 13px/1.5 var(--font-ui);
    color: var(--color-ink);
  }
  .alt {
    grid-column: 1;
    font: 400 10.5px/1.4 var(--font-ui);
    color: var(--color-ink-soft);
  }
  .check {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--color-accent-text);
  }
  .state {
    grid-column: 1;
    display: none;
    align-items: center;
    gap: 6px;
    font: 500 10.5px/1.4 var(--font-ui);
    color: var(--color-ink-soft);
  }
  .state::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  li[data-lang-status] .state:not(:empty) {
    display: inline-flex;
  }
  li[data-lang-status='failed'] .state::before {
    background: var(--color-accent2);
  }
  li[data-lang-status='missing'] .state::before {
    background: var(--color-ink-faint);
  }

  .signal {
    display: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .lang-btn[data-lang-signal] .signal {
    display: inline-block;
  }
  .lang-btn[data-lang-signal='failed'] .signal {
    background: var(--color-accent2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lang-btn[data-lang-signal='busy'] .signal {
      animation: lang-signal 2.4s ease-in-out infinite;
    }
  }
  @keyframes lang-signal {
    50% {
      opacity: 0.25;
    }
  }
  .row.here .name {
    color: var(--color-accent-text);
  }
  .sync {
    margin-top: 6px;
    padding: 8px 10px 4px;
    border-top: 1px solid var(--color-line);
  }
  .sync:has(> [hidden]) {
    display: none;
  }

  @media (max-width: 720px) {
    .lang-btn .cur {
      /* the bar is tight on phones: the mark alone names the control */
      display: none;
    }
  }
</style>
