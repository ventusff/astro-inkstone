---
/**
 * Site nav bar — the full-width chrome strip above every page: the mark at
 * the left (back to the garden), the breadcrumb trail (the bar's one nav
 * landmark), and at the right the search, language and theme controls.
 * Colors are the --color-* chrome tokens, which browse.css re-maps inside
 * the browse context — one bar, both grounds.
 *
 * Three of its parts are an INTERFACE, not decoration. astro-inkbrush's
 * client looks for them by name and silently does nothing when they are
 * missing:
 *
 *   .site-nav                          blocks.ts — offsets the ✎ edit handle
 *                                      so it clears the sticky bar
 *   [data-inkbrush-slot="account"]     auth.ts   — where the session chip
 *                                      docks; without it the chip is appended
 *                                      to <body> and floats over the text
 *   [data-inkbrush-slot="share"]       share.ts  — share chip (config-gated;
 *                                      the element is harmless when share is
 *                                      off)
 *
 * The fourth surface, the comment section, needs `main.note-main > .col` —
 * see layouts/NoteLayout.astro.
 */
import ThemeToggle from './ThemeToggle.astro';
import { href, landingRoute, otherLocale, UI, type Locale } from '../lib/i18n';

interface Crumb {
  label: string;
  route?: string | undefined;
}
interface Props {
  locale: Locale;
  crumbs: Crumb[];
  /** this page's route in the other locale; a page with no twin sends the
   *  language switch to the other locale's landing page instead */
  translateRoute?: string | undefined;
  /** render the menu button — only pages that have a sidebar drawer */
  hasSidebar?: boolean;
}
const { locale, crumbs, translateRoute, hasSidebar = false } = Astro.props;
const t = UI[locale];
const other = otherLocale(locale);
// the garden's landing page in this locale — the mark and the trail's root
const home = landingRoute(locale);
const switchRoute = translateRoute ?? landingRoute(other);
const switchTitle = translateRoute !== undefined ? t.langButton : t.langHome;
---

<header class="site-nav">
  {
    hasSidebar && (
      <button class="nav-toggle" type="button" aria-label={t.menu} aria-controls="site-sidebar" aria-expanded="false">
        ☰
      </button>
    )
  }
  <a class="hub-btn" href={href(home)} aria-label={t.home} title={t.home}>
    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
      <path d="M10 2.2 17.8 10 10 17.8 2.2 10Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
      <path d="M10 6.4 13.6 10 10 13.6 6.4 10Z" fill="currentColor"></path>
    </svg>
  </a>
  <span class="rule" aria-hidden="true"></span>
  {/* the breadcrumb landmark holds only the ordered trail — the surrounding
      controls are the bar's, not the breadcrumb's */}
  <nav class="trail-nav" aria-label={t.breadcrumb}>
    <ol class="trail">
      {/* each locale has its own landing page and browse tree */}
      <li><a class="gw" href={href(home)}>{t.home}</a></li>
      {
        crumbs.map((c) => (
          <li>{c.route !== undefined ? <a href={href(c.route)}>{c.label}</a> : <span class="here" aria-current="page">{c.label}</span>}</li>
        ))
      }
    </ol>
  </nav>
  <span class="spacer" aria-hidden="true"></span>

  <button class="search-btn" type="button" data-search-open title={t.searchButton} aria-label={t.searchButton}>
    <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
      <circle cx="9" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M13.2 13.2 17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
  </button>
  <a class="lang-btn" href={href(switchRoute)} title={switchTitle} hreflang={other === 'zh' ? 'zh-CN' : 'en'}>
    {t.langSwitch}
  </a>
  <span class="cms-slot" data-inkbrush-slot="share"></span>
  <span class="cms-slot" data-inkbrush-slot="account"></span>
  <ThemeToggle label={t.theme} />
</header>

<script>
  // Mobile drawer
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--nav-h);
    padding: 0 14px 0 10px;
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    backdrop-filter: saturate(170%) blur(10px);
    -webkit-backdrop-filter: saturate(170%) blur(10px);
    border-bottom: 1px solid var(--color-line);
    font: 500 12.5px/1 var(--font-ui);
    color: var(--color-ink-soft);
  }

  /* ---- the mark (back to the garden) ---- */
  .hub-btn {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: var(--color-brand);
    flex-shrink: 0;
    transition:
      background 0.15s ease,
      transform 0.5s cubic-bezier(0.34, 1.3, 0.44, 1);
  }
  .hub-btn:hover {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    transform: rotate(180deg);
  }

  .rule {
    width: 1px;
    height: 15px;
    background: var(--color-line);
    flex-shrink: 0;
  }

  /* ---- trail ---- */
  /* the landmark is transparent to the flex layout: it shrinks with the
     bar, and the list inside handles its own overflow */
  .trail-nav {
    display: flex;
    min-width: 0;
  }
  .trail {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }
  .trail::-webkit-scrollbar {
    display: none;
  }
  .trail li {
    display: inline-flex;
    align-items: center;
  }
  .trail li + li::before {
    content: '›';
    margin: 0 9px;
    /* faint ink at full opacity — the separator is text and must hold AA */
    color: var(--color-ink-faint);
  }
  .trail a {
    color: var(--color-ink-soft);
    text-decoration: none;
    padding: 3px 1px;
    border-bottom: 1px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .trail a:hover {
    color: var(--color-accent);
    border-bottom-color: currentColor;
  }
  .trail .gw {
    font-weight: 700;
    font-size: 13px;
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }
  .here {
    color: var(--color-ink);
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .spacer {
    flex: 1;
  }

  .search-btn {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 0.15s ease,
      border-color 0.15s ease;
  }
  .search-btn:hover {
    opacity: 1;
    border-color: currentColor;
  }

  .lang-btn {
    flex-shrink: 0;
    padding: 4px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 11.5px;
  }
  .lang-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* `display: contents` keeps the slot itself out of the flex layout, so the
     chip inkbrush injects becomes a direct flex item of the bar. */
  .cms-slot {
    display: contents;
  }

  @media (max-width: 720px) {
    .site-nav {
      padding: 0 10px;
      gap: 9px;
    }
    /* Narrow screens keep only "garden › current page": the full trail does
       not fit 430px and would be hard-clipped mid-word. Middle crumbs
       collapse; the last one ends in an ellipsis. */
    .trail {
      overflow-x: hidden;
    }
    .trail li:not(:first-child):not(:last-child) {
      display: none;
    }
    .trail li:last-child {
      min-width: 0;
    }
    .trail .here,
    .trail li:last-child a {
      display: block;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
