---
/** Stat row (landing heroes): a value and its label per tile. */
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<div class="stats">
  {
    items.map((s) => (
      <div class="stat">
        <span class="v">{s.value}</span>
        <span class="k">{s.label}</span>
      </div>
    ))
  }
</div>
