---
/**
 * Interactive demo mount point.
 *
 *   <DemoMount demo="waves/interference" title="Demo 1 · Wave interference playground"
 *              canvas={{ w: 720, h: 360 }}>
 *     <Fragment slot="controls">…buttons/sliders/readouts…</Fragment>
 *     <Fragment slot="caption">…2–4 sentences…</Fragment>
 *   </DemoMount>
 *
 * - canvas-based demo: pass `canvas={{w,h}}` (logical pixels, same as the
 *   original <canvas width height>); `stages={n}` renders n side-by-side
 *   canvases for multi-canvas demos. Each canvas is named by the demo's
 *   title (its fallback content too), so the stage has an accessible name,
 *   and the section landmark carries the same title as its aria-label;
 *   the caption slot carries the description (linked via aria-describedby).
 * - DOM demo (no canvas): omit `canvas` — the module builds its own DOM
 *   inside `.demo-stage`.
 * - `interactive` marks a demo that takes pointer input on its canvas: the
 *   stage then claims touch gestures (`touch-action: none`) and shows a
 *   crosshair cursor. A passive demo leaves it off, so a swipe over the
 *   canvas scrolls the page.
 *
 * Runtime contract (site-owned): this component only renders the mount
 * markup — `.demo[data-demo]` plus the stage and slots. The site provides
 * the loader and calls its `mountAllDemos()` once from its layout script;
 * the loader finds every `[data-demo]`, resolves the demo id to a module
 * (typically a dynamic import map over co-located `<id>.ts` files next to
 * the content), and calls the module's default export `mount(ctx)`, which
 * returns a cleanup function.
 */
interface Props {
  demo: string;
  title: string;
  canvas?: { w: number; h: number } | undefined;
  stages?: number | undefined;
  /** the demo takes pointer input on its canvas — claims touch gestures and
   *  shows a crosshair; off for passive (render-only) demos */
  interactive?: boolean | undefined;
  id?: string | undefined;
}
const { demo, title, canvas, stages = 1, interactive = false, id } = Astro.props;
if (!Number.isInteger(stages) || stages < 1) {
  throw new Error(`<DemoMount demo="${demo}">: stages must be a positive integer, got ${String(stages)}`);
}
if (canvas && (!(canvas.w > 0) || !(canvas.h > 0))) {
  throw new Error(`<DemoMount demo="${demo}">: canvas width and height must be positive, got ${String(canvas.w)}×${String(canvas.h)}`);
}
const canvases = canvas ? Array.from({ length: stages }) : [];
// caption id for aria-describedby — derived from the explicit id when given,
// else from the demo id (give repeated mounts of one demo explicit ids)
const hasCaption = Astro.slots.has('caption');
const captionId = hasCaption ? `${id ?? `demo-${demo.replace(/[^\w-]+/g, '-')}`}-caption` : undefined;
---

<section
  class="demo"
  id={id}
  data-demo={demo}
  data-interactive={interactive ? '' : undefined}
  aria-label={title}
  aria-describedby={captionId}
>
  <div class="demo-title">{title}</div>
  <div class:list={['demo-stage', stages > 1 && 'multi', !canvas && 'dom']}>
    {
      canvases.map((_, i) =>
        canvas && (
          <canvas width={canvas.w} height={canvas.h} role="img" aria-label={stages > 1 ? `${title} (${i + 1}/${stages})` : title}>
            {title}
          </canvas>
        ),
      )
    }
  </div>
  {
    Astro.slots.has('controls') && (
      <div class="demo-controls">
        <slot name="controls" />
      </div>
    )
  }
  {
    hasCaption && (
      <div class="demo-caption" id={captionId}>
        <slot name="caption" />
      </div>
    )
  }
</section>
