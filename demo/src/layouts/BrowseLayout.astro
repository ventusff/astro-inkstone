---
/**
 * Browse page: Base shell in the browse context (`body.wb-root`, styled by
 * the package's browse.css) + one wide column. No sidebar — browse pages are
 * their own navigation.
 */
import Base from './Base.astro';
import type { Locale } from '../lib/i18n';

interface Crumb {
  label: string;
  route?: string | undefined;
}

interface Props {
  title: string;
  description?: string | undefined;
  locale?: Locale;
  crumbs?: Crumb[];
}
const { title, description, locale = 'en', crumbs = [] } = Astro.props;
---

<Base title={title} description={description} locale={locale} crumbs={crumbs} bodyClass="wb-root">
  <main id="main">
    <slot />
  </main>
</Base>
