---
/** /tag/<tag>/ — browse by free tag. */
import FacetNav from 'astro-inkstone/components/wiki/FacetNav.astro';
import NoteCard from 'astro-inkstone/components/wiki/NoteCard.astro';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { cardOf, facetBase } from '../../lib/display';
import { getWikiUnits, groupByKind, groupByDomain, tagIndex, type ResolvedNote } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const units = await getWikiUnits();
  return [...tagIndex(units).entries()].map(([tag, notes]) => ({
    params: { tag },
    props: { tag, notes },
  }));
}

interface Props {
  tag: string;
  notes: ResolvedNote[];
}
const { tag, notes } = Astro.props;

const units = await getWikiUnits();
const kinds = groupByKind(units).map((g) => ({ def: g.def, count: g.notes.length }));
const domains = groupByDomain(units).map((g) => ({ def: g.def, count: g.notes.length }));
const tags = [...tagIndex(units).entries()].slice(0, 10).map(([tag, list]) => ({ tag, count: list.length }));
---

<BrowseLayout title={`#${tag}`} description={`Notes tagged ${tag} (${notes.length})`} crumbs={[{ label: `#${tag}` }]}>
  <header class="wb-hero">
    <p class="wb-kicker">By tag <span class="sep">·</span> 按标签</p>
    <h1 class="wb-title">#{tag}</h1>
    <p class="wb-lede"><strong>{notes.length}</strong> notes.</p>
  </header>
  <FacetNav base={facetBase} kinds={kinds} domains={domains} tags={tags} active={{ dim: 'tag', value: tag }} />
  <ul class="wb-grid">
    {notes.map((note) => <NoteCard note={cardOf(note)} />)}
  </ul>
</BrowseLayout>
