{
  "name": "astro-inkstone-demo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The astro-inkstone demo garden — a multi-note taxonomy site whose notes are the package manual",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node vendor/astro-inkbrush/scripts/check-dist.mjs dist --base ${DEMO_BASE:-/} ${PLAYGROUND:+--playground}",
    "preview": "astro preview",
    "wiki": "WIKI=1 astro dev",
    "check": "node vendor/astro-inkbrush/scripts/check-content.mjs src/content/notes --math && node scripts/check-links.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "astro": "^7.1.6",
    "astro-inkbrush": "file:vendor/astro-inkbrush",
    "astro-inkstone": "file:..",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
