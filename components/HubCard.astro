---
/**
 * Hub landing card — one card per chapter on a collection's overview page,
 * laid out by `.hub-grid` (base.css):
 *
 *   <div class="hub-grid">
 *     <HubCard href="/chasing/primer/" num="PART I" title="Primer" count="§1.1–§1.4"
 *              chips={[{ label: 'Roofline', variant: 'teal' }]}>
 *       One sentence on what the chapter covers (markdown works).
 *     </HubCard>
 *   </div>
 *
 * The card is an <article> whose title anchor is stretched over it (its
 * ::after covers the card, base.css), so the slot may carry Markdown links
 * of its own — they sit above the overlay and never nest inside an anchor.
 * The card's accessible name is the title link.
 *
 * `soft` gives the card the secondary surface (an appendix, a side track).
 */
import Chip, { type ChipVariant } from './Chip.astro';
import type { Tone } from '../lib/wiki-display.ts';

export interface HubChip {
  label: string;
  variant?: ChipVariant | undefined;
  /** custom category color — the same Tone pair Chip and PaperCard take */
  tone?: Tone | undefined;
}

interface Props {
  href: string;
  num?: string | undefined;
  title: string;
  chips?: HubChip[] | undefined;
  count?: string | undefined;
  soft?: boolean | undefined;
}
const { href, num, title, chips = [], count, soft = false } = Astro.props;
---

<article class:list={['hub-card', soft && 'soft']}>
  {num && <span class="num">{num}</span>}
  <h3><a class="hub-card-link" href={href}>{title}</a></h3>
  <div class="one-liner"><slot /></div>
  {
    chips.length > 0 && (
      <div class="topics">
        {chips.map((c) => (
          <Chip variant={c.variant} tone={c.tone}>{c.label}</Chip>
        ))}
      </div>
    )
  }
  <div class="meta">
    {count && <span class="count">{count}</span>}
    <span class="arrow">→</span>
  </div>
</article>
