---
/**
 * Interactive demo mount point.
 *
 *   <DemoMount demo="waves/interference" title="Demo 1 · Wave interference playground"
 *              canvas={{ w: 720, h: 360 }}>
 *     <Fragment slot="controls">…buttons/sliders/readouts…</Fragment>
 *     <Fragment slot="caption">…2–4 sentences…</Fragment>
 *   </DemoMount>
 *
 * - canvas-based demo: pass `canvas={{w,h}}` (logical pixels, same as the
 *   original <canvas width height>); `stages={n}` renders n side-by-side
 *   canvases for multi-canvas demos. Each canvas is named by the demo's
 *   title (its fallback content too), so the stage has an accessible name,
 *   and the section landmark carries the same title as its aria-label;
 *   the caption slot carries the description (linked via aria-describedby).
 * - DOM demo (no canvas): omit `canvas` — the module builds its own DOM
 *   inside `.demo-stage`.
 * - `interactive` marks a demo that takes pointer input on its canvas: the
 *   stage then claims touch gestures (`touch-action: none`) and shows a
 *   crosshair cursor. A passive demo leaves it off, so a swipe over the
 *   canvas scrolls the page.
 *
 * Which module runs the demo is named in one of two ways:
 *
 * - `module` — the path, from the site root, of a `.ts` file under
 *   `src/content/`, usually beside the page that shows it (an interactive
 *   figure and its JSON live with the page that answers them). The engine
 *   loads and mounts it (lib/page-demos.ts); the site wires nothing.
 *
 *     <DemoMount module="/src/content/docs/skills/start-range/entry-paths.ts" title="…" canvas={{ w: 720, h: 360 }} />
 *
 * - `demo` — an id the site's own loader resolves: this component renders
 *   `.demo[data-demo]` plus the stage and slots, and the site calls its
 *   `mountAllDemos()` from its layout script, which finds every
 *   `[data-demo]` and maps the id to a module (typically an import map over
 *   `<id>.ts` files of the site).
 *
 * Either module default-exports `mount(ctx)` and returns a cleanup function.
 */
type Props = (
  | { /** a `.ts` under `src/content/`, by its path from the site root */ module: string; demo?: never }
  | { /** an id the site's loader resolves */ demo: string; module?: never }
) & {
  title: string;
  canvas?: { w: number; h: number } | undefined;
  stages?: number | undefined;
  /** the demo takes pointer input on its canvas — claims touch gestures and
   *  shows a crosshair; off for passive (render-only) demos */
  interactive?: boolean | undefined;
  id?: string | undefined;
  /** the language of the words the module shows; default the route's */
  locale?: string | undefined;
};
const { demo, module, title, canvas, stages = 1, interactive = false, id, locale = Astro.currentLocale } = Astro.props;
const name = demo ?? module;
if (!Number.isInteger(stages) || stages < 1) {
  throw new Error(`<DemoMount ${name}>: stages must be a positive integer, got ${String(stages)}`);
}
if (canvas && (!(canvas.w > 0) || !(canvas.h > 0))) {
  throw new Error(`<DemoMount ${name}>: canvas width and height must be positive, got ${String(canvas.w)}×${String(canvas.h)}`);
}
const canvases = canvas ? Array.from({ length: stages }) : [];
// caption id for aria-describedby — derived from the explicit id when given,
// else from the demo id or module path (give repeated mounts of one demo explicit ids)
const hasCaption = Astro.slots.has('caption');
const captionId = hasCaption ? `${id ?? `demo-${name.replace(/^\/|\.ts$/g, '').replace(/[^\w-]+/g, '-')}`}-caption` : undefined;
---

<section
  class="demo"
  id={id}
  data-demo={demo}
  data-demo-module={module}
  data-locale={module ? locale : undefined}
  data-interactive={interactive ? '' : undefined}
  aria-label={title}
  aria-describedby={captionId}
>
  <div class="demo-title">{title}</div>
  <div class:list={['demo-stage', stages > 1 && 'multi', !canvas && 'dom']}>
    {
      canvases.map((_, i) =>
        canvas && (
          <canvas width={canvas.w} height={canvas.h} role="img" aria-label={stages > 1 ? `${title} (${i + 1}/${stages})` : title}>
            {title}
          </canvas>
        ),
      )
    }
  </div>
  {
    Astro.slots.has('controls') && (
      <div class="demo-controls">
        <slot name="controls" />
      </div>
    )
  }
  {
    hasCaption && (
      <div class="demo-caption" id={captionId}>
        <slot name="caption" />
      </div>
    )
  }
</section>

<script>
  import { mountPageDemos } from '../lib/page-demos.ts';
  mountPageDemos();
  document.addEventListener('astro:page-load', () => mountPageDemos());
</script>
