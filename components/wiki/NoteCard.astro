---
/**
 * NoteCard — note card for browse pages: short-name badge / kind badge /
 * chapter count / date of the latest change and the authors / title /
 * description / domain chips / status dot / locale mirrors / source line.
 * Lives on the browse shelf (browse.css, `--wb-*`).
 *
 * Purely presentational: the site resolves registry defs and URLs (e.g. with
 * the `createTaxonomy` helpers from `astro-inkstone/lib/taxonomy`) and passes
 * a display-ready object in. The short-name badge takes the first domain's
 * tone, so a shelf of cards reads as a row of project labels.
 */
import DomainChip from './DomainChip.astro';
import KindBadge from './KindBadge.astro';
import StatusDot from './StatusDot.astro';
import type { DomainDisplay, KindDisplay, StatusDisplay } from '../../lib/wiki-display.ts';

export interface NoteCardData {
  /** Canonical note id — emitted on data-* attributes for styling/filter hooks. */
  id: string;
  href: string;
  /** the note's short name (a project or series name), shown as the card's badge */
  brand?: string | undefined;
  title: string;
  description?: string | undefined;
  kind?: KindDisplay | undefined;
  domains: DomainDisplay[];
  status?: StatusDisplay | undefined;
  /** Pre-formatted display date of the latest change ("2026.10.02", "today", …). */
  updated?: string | undefined;
  /** who wrote the note, names already joined for the reader's language; shown after the date, or alone without one */
  authors?: string | undefined;
  /** whole days since the latest change — emitted as data-age for the recent shelf's window filter */
  ageDays?: number | undefined;
  /** Chapter count, for multi-chapter collection notes. */
  chapterCount?: number | undefined;
  /** Other-locale mirrors of this note, e.g. [{ label: 'EN', href: '/en/note/' }]. */
  mirrors?: { label: string; href: string }[] | undefined;
  /** Pre-joined source line (paper title · venue · arXiv id, …). */
  sourceLine?: string | undefined;
}

interface Props {
  note: NoteCardData;
  /** Display strings; pass localized overrides. */
  labels?: { chapters?: ((n: number) => string) | undefined } | undefined;
}
const { note, labels = {} } = Astro.props;
const chaptersLabel = labels.chapters ?? ((n: number) => `${n} chapters`);
const tone = note.domains[0]?.tone;
const brandStyle = tone ? `--brand-bg:${tone.bg}; --brand-fg:${tone.fg};` : undefined;
---

<li
  class="note-card"
  data-id={note.id}
  data-kind={note.kind?.id}
  data-domains={note.domains.map((d) => d.id).join(' ')}
  data-status={note.status?.id}
  data-age={note.ageDays}
>
  <div class="head">
    {note.brand && <span class="brand" style={brandStyle}>{note.brand}</span>}
    {note.kind && <KindBadge def={note.kind} />}
    {note.chapterCount !== undefined && <span class="chapters">{chaptersLabel(note.chapterCount)}</span>}
    {(note.updated || note.authors) && (
      <span class="date">
        {note.updated}
        {note.authors && <span class="by">{note.updated && '· '}{note.authors}</span>}
      </span>
    )}
  </div>
  <a class="title" href={note.href}>{note.title}</a>
  {note.description && <p class="desc">{note.description}</p>}
  <div class="meta">
    {note.domains.map((dom) => <DomainChip def={dom} />)}
    {note.status && <StatusDot def={note.status} />}
    {(note.mirrors ?? []).map((m) => (
      <a class="mirror" href={m.href}>{m.label}</a>
    ))}
  </div>
  {note.sourceLine && <p class="source">{note.sourceLine}</p>}
</li>

<style>
  .note-card {
    display: flex;
    flex-direction: column;
    gap: 7px;
    background: var(--wb-bg-card);
    border: 1px solid var(--wb-border-soft);
    border-radius: var(--radius);
    padding: 16px 18px;
    transition: border-color 0.15s ease;
  }
  .note-card:hover {
    border-color: var(--wb-rule);
  }

  .head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .brand {
    display: inline-block;
    max-width: 100%;
    font: 700 11.5px/1 var(--font-ui);
    letter-spacing: 0.02em;
    color: var(--brand-fg, var(--color-accent-text));
    background: var(--brand-bg, var(--color-accent-soft));
    border-radius: 4px;
    padding: 4px 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(:root[data-theme='dark']) .brand {
    background: color-mix(in srgb, var(--brand-fg, var(--color-accent)) 22%, transparent);
    color: color-mix(in srgb, var(--brand-fg, var(--color-accent)) 50%, var(--color-ink));
  }
  .chapters {
    font: 500 11px/1 var(--wb-sans);
    color: var(--wb-text-dim);
  }
  /* the date never breaks; a long author list wraps under it, right-aligned,
     instead of pushing the card wider than its column */
  .date {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: 4px;
    row-gap: 4px;
    max-width: 100%;
    min-width: 0;
    margin-left: auto;
    font: 500 11px/1 var(--wb-sans);
    color: var(--wb-text-muted);
    white-space: nowrap;
  }
  .by {
    min-width: 0;
    font-weight: 400;
    color: var(--wb-text-dim);
    white-space: normal;
    text-align: right;
  }

  .title {
    font-size: 17.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--wb-text);
    text-decoration: none;
  }
  .title:hover {
    color: var(--wb-wine);
  }

  .desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--wb-text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* long unbreakable runs (paper names joined by arrows/slashes) must wrap
       inside the clamp box instead of being cut off at its right edge */
    overflow-wrap: anywhere;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .mirror {
    font: 600 10px/1 var(--wb-sans);
    letter-spacing: 0.06em;
    color: var(--wb-text-dim);
    border: 1px solid var(--wb-border);
    border-radius: 3px;
    padding: 3px 5px;
    text-decoration: none;
  }
  .mirror:hover {
    color: var(--wb-wine);
    border-color: currentColor;
  }

  /* clamped like .desc: a card is a summary, and no field may set its height */
  .source {
    margin: 0;
    font: 400 11.5px/1.5 var(--wb-sans);
    color: var(--wb-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
</style>
