---
/**
 * SidebarMemory — keeps a scrolling sidebar where the reader left it across
 * full page loads, and brings the current item into view when it is not.
 *
 * Place it inside the element that scrolls (the sidebar's scroll box), after
 * the navigation markup. The script runs inline, before first paint, so the
 * sidebar never flashes at the top.
 *
 * Behaviour, in order:
 *   1. restore the scroll offset saved for this site (sessionStorage);
 *   2. if the current item is outside the visible box, centre it;
 *   3. keep saving the offset while the reader scrolls and when the page is
 *      left.
 * Without sessionStorage (private mode, storage blocked) only step 2 runs.
 *
 * Props:
 *   current — selector for the current item; `[aria-current="page"]` by
 *             default, which is also the accessible way to mark it
 *   key     — storage key suffix; the site base by default, so sites that
 *             share an origin keep separate positions
 */
interface Props {
  current?: string;
  key?: string;
}
const { current = '[aria-current="page"]', key = import.meta.env.BASE_URL } = Astro.props;
---

<script is:inline data-current={current} data-key={key}>
  (() => {
    const script = document.currentScript;
    const box = script && script.parentElement;
    if (!box) return;
    const key = `inkstone:sidebar:${script.dataset.key || ''}`;

    // Every storage access is guarded: sessionStorage itself, getItem and
    // setItem can all throw (storage blocked, quota exceeded); a failed
    // read behaves as "nothing stored", a failed write keeps nothing.
    let store = null;
    try {
      store = window.sessionStorage;
    } catch {
      store = null;
    }
    const read = () => {
      if (!store) return null;
      try {
        return store.getItem(key);
      } catch {
        return null;
      }
    };
    const save = () => {
      if (!store) return;
      try {
        store.setItem(key, String(box.scrollTop));
      } catch {
        /* the position is just not kept */
      }
    };

    // Restore and reveal happen instantly: a smooth-scrolling sidebar would
    // otherwise animate on every page load. The inline behaviour is restored
    // whatever happens in between.
    const behaviour = box.style.scrollBehavior;
    box.style.scrollBehavior = 'auto';
    try {
      const saved = read();
      const offset = saved === null ? NaN : Number(saved);
      // no stored value (or a garbled one) → no restore
      if (Number.isFinite(offset)) box.scrollTop = offset;

      let item = null;
      try {
        item = script.dataset.current ? box.querySelector(script.dataset.current) : null;
      } catch {
        item = null; // an invalid selector disables the reveal, nothing else
      }
      if (item) {
        const top = item.getBoundingClientRect().top - box.getBoundingClientRect().top;
        const visible = top >= 0 && top + item.offsetHeight <= box.clientHeight;
        if (!visible) box.scrollTop += top - (box.clientHeight - item.offsetHeight) / 2;
      }
    } finally {
      box.style.scrollBehavior = behaviour;
    }

    if (!store) return;
    let timer;
    box.addEventListener(
      'scroll',
      () => {
        clearTimeout(timer);
        timer = setTimeout(save, 120);
      },
      { passive: true },
    );
    addEventListener('pagehide', save);
  })();
</script>
