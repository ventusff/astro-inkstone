---
/**
 * Interactive demo mount point.
 *
 *   <DemoMount demo="waves/interference" title="Demo 1 · Wave interference playground"
 *              canvas={{ w: 720, h: 360 }}>
 *     <Fragment slot="controls">…buttons/sliders/readouts…</Fragment>
 *     <Fragment slot="caption">…2–4 sentences…</Fragment>
 *   </DemoMount>
 *
 * - canvas-based demo: pass `canvas={{w,h}}` (logical pixels, same as the
 *   original <canvas width height>); `stages={n}` renders n side-by-side
 *   canvases for multi-canvas demos. Each canvas is named by the demo's
 *   title (its fallback content too), so the stage has an accessible name;
 *   the caption slot carries the description.
 * - DOM demo (no canvas): omit `canvas` — the module builds its own DOM
 *   inside `.demo-stage`.
 *
 * Runtime contract (site-owned): this component only renders the mount
 * markup — `.demo[data-demo]` plus the stage and slots. The site provides
 * the loader and calls its `mountAllDemos()` once from its layout script;
 * the loader finds every `[data-demo]`, resolves the demo id to a module
 * (typically a dynamic import map over co-located `<id>.ts` files next to
 * the content), and calls the module's default export `mount(ctx)`, which
 * returns a cleanup function.
 */
interface Props {
  demo: string;
  title: string;
  canvas?: { w: number; h: number } | undefined;
  stages?: number | undefined;
  id?: string | undefined;
}
const { demo, title, canvas, stages = 1, id } = Astro.props;
const canvases = canvas ? Array.from({ length: stages }) : [];
---

<section class="demo" id={id} data-demo={demo}>
  <div class="demo-title">{title}</div>
  <div class:list={['demo-stage', stages > 1 && 'multi', !canvas && 'dom']}>
    {
      canvases.map((_, i) =>
        canvas && (
          <canvas width={canvas.w} height={canvas.h} role="img" aria-label={stages > 1 ? `${title} (${i + 1}/${stages})` : title}>
            {title}
          </canvas>
        ),
      )
    }
  </div>
  {
    Astro.slots.has('controls') && (
      <div class="demo-controls">
        <slot name="controls" />
      </div>
    )
  }
  {
    Astro.slots.has('caption') && (
      <div class="demo-caption">
        <slot name="caption" />
      </div>
    )
  }
</section>
