---
/**
 * Callout — the same markup the `> [!tip]` quote syntax renders
 * (lib/remark-callouts.ts): an <aside class="callout …"> with a title line.
 * Five variants: note (default), intuition, warn, system, abstract. `title`
 * replaces the variant's default label; `labels` supplies localized defaults
 * (the same shape as siteMarkdown's `calloutLabels`).
 */
type Variant = 'note' | 'intuition' | 'warn' | 'system' | 'abstract';

interface Props {
  variant?: Variant | undefined;
  title?: string | undefined;
  labels?: Partial<Record<Variant, string>> | undefined;
}
const { variant = 'note', title, labels = {} } = Astro.props;

const DEFAULT_LABELS: Record<Variant, string> = {
  note: 'Note',
  intuition: 'Intuition',
  warn: 'Warning',
  system: 'Important',
  abstract: 'Abstract',
};
const heading = title ?? labels[variant] ?? DEFAULT_LABELS[variant];
---

<aside class:list={['callout', variant !== 'note' && variant]}>
  <div class="callout-title">{heading}</div>
  <slot />
</aside>
