---
/**
 * /all/ — every browse unit, newest first, with instant filters and the
 * full tag index. The filter pills are links to the facet pages (kind /
 * domain / status routes); the script below turns them into in-page filters
 * (one value per dimension, AND across dimensions) that announce their
 * result count — without it every pill still leads somewhere.
 */
import FacetNav from 'astro-inkstone/components/wiki/FacetNav.astro';
import NoteCard from 'astro-inkstone/components/wiki/NoteCard.astro';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { browseHref, cardOf, facetBase } from '../../lib/display';
import { getWikiUnits, groupByKind, groupByDomain, tagIndex } from '../../lib/taxonomy';
import { DOMAINS, KINDS, STATUSES } from '../../content/notes/_meta/taxonomy';

const units = await getWikiUnits();
const kinds = groupByKind(units).map((g) => ({ def: g.def, count: g.notes.length }));
const domains = groupByDomain(units).map((g) => ({ def: g.def, count: g.notes.length }));
const tags = [...tagIndex(units).entries()].slice(0, 10).map(([tag, list]) => ({ tag, count: list.length }));
const allTags = [...tagIndex(units).keys()];
const kindDefs = KINDS.filter((k) => units.some((u) => u.kind === k.id));
const domainDefs = DOMAINS.filter((d) => units.some((u) => u.domains.includes(d.id)));
const statusDefs = STATUSES.filter((s) => units.some((u) => u.status === s.id));
---

<BrowseLayout title="All notes" description={`Every note in the garden (${units.length}), newest first, with instant filters.`} crumbs={[{ label: 'All notes' }]}>
  <header class="wb-hero">
    <p class="wb-kicker">All notes <span class="sep">·</span> everything</p>
    <h1 class="wb-title">All notes<span class="en">{units.length} entries</span></h1>
    <p class="wb-lede">Newest first. The pills below filter in place; without JavaScript they lead to the facet pages.</p>
  </header>
  <FacetNav base={facetBase} kinds={kinds} domains={domains} tags={tags} active={{ dim: 'all' }} />

  <div class="wb-filters" data-filters>
    <span class="f-dim">Kind</span>
    {kindDefs.map((k) => (
      <a class="f-pill" href={browseHref.kind(k.id)} data-filter="kind" data-value={k.id}>{k.label}</a>
    ))}
    <span class="f-dim">Domain</span>
    {domainDefs.map((d) => (
      <a class="f-pill" href={browseHref.domain(d.id)} data-filter="domain" data-value={d.id}>{d.label}</a>
    ))}
    <span class="f-dim">Status</span>
    {statusDefs.map((s) => (
      <a class="f-pill" href={browseHref.status(s.id)} data-filter="status" data-value={s.id}>{s.label}</a>
    ))}
    <button class="f-clear" type="button" data-clear hidden>Clear filters</button>
    <span class="wb-count" role="status" aria-live="polite" data-count></span>
  </div>

  <ul class="wb-grid" data-cards>
    {units.map((note) => <NoteCard note={cardOf(note)} />)}
  </ul>
  <p class="wb-empty" data-empty hidden>No note matches every selected filter.</p>

  <section class="wb-tags">
    <h2 class="wb-tags-title">All tags</h2>
    {allTags.map((t) => <a class="wb-tag" href={browseHref.tag(t)}>#{t}</a>)}
  </section>
</BrowseLayout>

<script>
  // Progressive enhancement: pills become instant filters. Card attributes
  // come from NoteCard's data-* (kind / domains / status). An active pill is
  // marked aria-current; the live region announces the count.
  const root = document.querySelector('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-cards] > li')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (root && cards.length > 0 && empty && clearBtn && count) {
    const active = new Map<string, string>(); // dimension → value (one per dimension)
    const pills = [...root.querySelectorAll<HTMLAnchorElement>('.f-pill')];

    const apply = (): void => {
      let shown = 0;
      for (const card of cards) {
        const ok = [...active.entries()].every(([dim, value]) => {
          if (dim === 'domain') return (card.dataset['domains'] ?? '').split(' ').includes(value);
          return card.dataset[dim] === value;
        });
        card.hidden = !ok;
        if (ok) shown += 1;
      }
      empty.hidden = shown > 0;
      clearBtn.hidden = active.size === 0;
      count.textContent = active.size === 0 ? '' : `${shown} / ${cards.length}`;
      for (const p of pills) {
        const on = active.get(p.dataset['filter'] ?? '') === p.dataset['value'];
        p.toggleAttribute('data-on', on);
        if (on) p.setAttribute('aria-current', 'true');
        else p.removeAttribute('aria-current');
      }
    };

    for (const p of pills) {
      p.addEventListener('click', (e) => {
        e.preventDefault();
        const dim = p.dataset['filter'] ?? '';
        const value = p.dataset['value'] ?? '';
        if (active.get(dim) === value) active.delete(dim);
        else active.set(dim, value);
        apply();
      });
    }
    clearBtn.addEventListener('click', () => {
      active.clear();
      apply();
    });
  }
</script>
