---
/**
 * Note-page sidebar — brand, the language switch, a hub's chapter rail
 * (when the note belongs to one), and the current page's section anchors,
 * which the scroll-spy in Base.astro highlights (`.toc ul.sub a`).
 *
 * Chapter numbers come from POSITION in the hub's nav — never typed
 * anywhere, so inserting a chapter renumbers the rail at once.
 */
import { renderTocLabel } from 'astro-inkstone/lib/toc';
import type { TocData } from 'astro-inkstone/lib/toc-types';
import { href, UI, type Locale } from '../lib/i18n';

export interface HubRow {
  href: string;
  /** rail row label, e.g. "Ⅱ. Wiki & browse" */
  label: string;
  here: boolean;
}
export interface HubNav {
  hubHref: string;
  hubLabel: string;
  hubHere: boolean;
  groups: { label: string; rows: HubRow[] }[];
}
export interface LangNav {
  langs: { code: string; label: string; href: string; current: boolean }[];
}

interface Props {
  locale: Locale;
  /** the current note's title (the `.here` row when there is no hub rail) */
  title: string;
  toc: TocData;
  tocDepth?: 2 | 3;
  hub?: HubNav | undefined;
  lang?: LangNav | undefined;
}
const { locale, title, toc, tocDepth = 2, hub, lang } = Astro.props;
const t = UI[locale];

interface Anchor {
  id: string;
  num: string;
  label: string;
}
const anchors: Anchor[] = toc.items
  .filter((i) => i.kind === 'entry' && i.depth <= tocDepth)
  .map((i) => ({ id: (i as { id: string }).id, num: (i as { num: string }).num, label: i.label }));
---

<aside class="sidebar" id="site-sidebar">
  {/* the brand is chrome, not the document's title: the ONE h1 on every page
      is the article heading, so this stays a plain div */}
  <a class="brand-link" href={href('')}>
    <div class="brand-title"><span class="glyph" aria-hidden="true">◈</span>astro-<em>inkstone</em></div>
    <div class="subtitle">{t.brandSub}</div>
  </a>

  {
    lang && (
      <div class="lang-row" aria-label="Languages">
        {lang.langs.map((l) =>
          l.current ? (
            <span class="lang-chip current" aria-current="page">
              {l.label}
            </span>
          ) : (
            <a class="lang-chip" href={l.href}>
              {l.label}
            </a>
          ),
        )}
      </div>
    )
  }

  <nav aria-label="Contents">
    <ul class="toc">
      {
        hub &&
          hub.groups.map((group) => (
            <>
              <li class="part-head">
                <span>{group.label}</span>
              </li>
              <li>
                {hub.hubHere ? (
                  <span class="here" aria-current="page">
                    <span class="num-col">·</span>
                    {hub.hubLabel}
                  </span>
                ) : (
                  <a href={hub.hubHref}>
                    <span class="num-col">·</span>
                    {hub.hubLabel}
                  </a>
                )}
                {hub.hubHere && anchors.length > 0 && (
                  <ul class="sub">
                    {anchors.map((e) => (
                      <li>
                        <a href={`#${e.id}`}>
                          <span class="idx">{e.num}</span>
                          <Fragment set:html={renderTocLabel(e.label)} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
              {group.rows.map((row) => (
                <li>
                  {row.here ? (
                    <span class="here" aria-current="page">
                      {row.label}
                    </span>
                  ) : (
                    <a href={row.href}>{row.label}</a>
                  )}
                  {row.here && anchors.length > 0 && (
                    <ul class="sub">
                      {anchors.map((e) => (
                        <li>
                          <a href={`#${e.id}`}>
                            <span class="idx">{e.num}</span>
                            <Fragment set:html={renderTocLabel(e.label)} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </>
          ))
      }
      {
        !hub && (
          <li>
            <span class="here" aria-current="page">
              {title}
            </span>
            {anchors.length > 0 && (
              <ul class="sub">
                {anchors.map((e) => (
                  <li>
                    <a href={`#${e.id}`}>
                      <span class="idx">{e.num}</span>
                      <Fragment set:html={renderTocLabel(e.label)} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        )
      }
    </ul>
  </nav>
</aside>
