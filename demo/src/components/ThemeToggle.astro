---
/** Light/dark toggle in the nav bar. Same key as ThemeInit ('inkstone-theme'). */
---

<button class="theme-toggle" type="button" aria-label="Toggle light / dark theme" title="Light / dark">
  <svg class="icon-sun" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <circle cx="8" cy="8" r="3.4" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
      <path d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3 3l1.3 1.3M11.7 11.7L13 13M13 3l-1.3 1.3M4.3 11.7L3 13"
      ></path>
    </g>
  </svg>
  <svg class="icon-moon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <path d="M13.4 9.6A6 6 0 1 1 6.4 2.6a4.8 4.8 0 1 0 7 7z" fill="currentColor"></path>
  </svg>
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset['theme'] === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset['theme'] = next;
      try {
        localStorage.setItem('inkstone-theme', next);
      } catch {
        /* private mode: theme still flips, it just is not remembered */
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 7px;
    border: 1px solid transparent;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 0.15s ease,
      border-color 0.15s ease;
  }
  .theme-toggle:hover {
    opacity: 1;
    border-color: currentColor;
  }
  /* light shows the moon (press to go dark), dark shows the sun */
  .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }
</style>
