---
/**
 * Note page: Base shell + sidebar + reading column.
 *
 * The column's order is the wiki's: the taxonomy strip, the hub crumb when
 * the note is a chapter, the note itself (which opens with its own <Hero>
 * or <PartHero>), the linked mentions, prev/next for chapters, small print.
 *
 * `main.note-main > .col` is astro-inkbrush's mount contract for the comment
 * section — keep the pair intact.
 */
import Backlinks from 'astro-inkstone/components/Backlinks.astro';
import LocalGraph, { type LocalGraphNeighbor } from 'astro-inkstone/components/LocalGraph.astro';
import PageFooter from 'astro-inkstone/components/PageFooter.astro';
import TaxonomyLine from 'astro-inkstone/components/wiki/TaxonomyLine.astro';
import type { BacklinkItem } from 'astro-inkstone/lib/backlinks';
import type { TocData } from 'astro-inkstone/lib/toc-types';
import Base from './Base.astro';
import Sidebar, { type HubNav, type LangNav } from '../components/Sidebar.astro';
import { UI, type Locale } from '../lib/i18n';

interface Crumb {
  label: string;
  route?: string | undefined;
}

/** auto-generated chrome for hub chapter pages */
export interface HubPageChrome {
  /** "Part Ⅱ · Wiki & browse" — shown in the in-column crumb */
  crumbLabel: string;
  hubHref: string;
  prev?: { href: string; label: string } | undefined;
  next?: { href: string; label: string } | undefined;
}

/** display-ready taxonomy strip data (assembled by the route) */
export interface TaxonomyStrip {
  kind?: { id: string; label: string; desc?: string | undefined } | undefined;
  domains: {
    id: string;
    label: string;
    desc?: string | undefined;
    tone: { bg: string; fg: string };
    href?: string | undefined;
  }[];
  status?: { id: string; label: string; desc?: string | undefined; dot: string } | undefined;
  updated?: string | undefined;
}

interface Props {
  title: string;
  description?: string | undefined;
  locale: Locale;
  crumbs: Crumb[];
  /** sidebar brand line (the note's short title) and its link */
  brand: string;
  brandHref: string;
  subtitle?: string | undefined;
  noteId?: string | undefined;
  translateRoute?: string | undefined;
  toc: TocData;
  tocDepth?: 2 | 3;
  taxonomy?: TaxonomyStrip | undefined;
  hub?: HubNav | undefined;
  hubPage?: HubPageChrome | undefined;
  lang?: LangNav | undefined;
  backlinks?: BacklinkItem[] | undefined;
  /** one-hop link neighbourhood for the sidebar graph; empty = no panel */
  graph?: LocalGraphNeighbor[] | undefined;
}
const {
  title,
  description,
  locale,
  crumbs,
  brand,
  brandHref,
  subtitle,
  noteId,
  translateRoute,
  toc,
  tocDepth = 2,
  taxonomy,
  hub,
  hubPage,
  lang,
  backlinks = [],
  graph = [],
} = Astro.props;
const t = UI[locale];
const zh = locale === 'zh';
---

<Base
  title={title}
  description={description}
  locale={locale}
  crumbs={crumbs}
  translateRoute={translateRoute}
  noteId={noteId}
>
  <div class="layout">
    <Sidebar brand={brand} brandHref={brandHref} subtitle={subtitle} toc={toc} tocDepth={tocDepth} hub={hub} lang={lang}>
      {graph.length > 0 && <LocalGraph centerTitle={title} neighbors={graph} label={t.localGraph} />}
    </Sidebar>
    <main class="note-main">
      <div class="col">
        {
          taxonomy && (
            <TaxonomyLine
              kind={taxonomy.kind}
              domains={taxonomy.domains}
              status={taxonomy.status}
              updated={taxonomy.updated}
              labels={{ updated: t.updated }}
            />
          )
        }
        {
          hubPage && (
            <div class="crumb">
              <a href={hubPage.hubHref}>{t.hub}</a>
              <span class="sep">›</span>
              {hubPage.crumbLabel}
            </div>
          )
        }
        <slot />
        {
          backlinks.length > 0 && (
            <Backlinks items={backlinks} heading={t.backlinks} sub={zh ? 'Linked mentions' : ''} />
          )
        }
        {
          hubPage && (hubPage.prev || hubPage.next) && (
            <nav class="pagination" aria-label="Chapter pagination">
              {hubPage.prev ? (
                <a class="prev" href={hubPage.prev.href}>
                  <div class="dir">← prev</div>
                  <div class="title">{hubPage.prev.label}</div>
                </a>
              ) : (
                <span />
              )}
              {hubPage.next ? (
                <a class="next" href={hubPage.next.href}>
                  <div class="dir">next →</div>
                  <div class="title">{hubPage.next.label}</div>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
        <PageFooter>
          <p>{t.footer}</p>
        </PageFooter>
      </div>
    </main>
  </div>
</Base>
