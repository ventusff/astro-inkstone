---
/**
 * Kind badge — small monochrome square (the note's form factor stays
 * visually quieter than domain colors). Purely presentational: the site
 * resolves the def from its registry and passes it in.
 */
import type { KindDisplay } from '../../lib/wiki-display.ts';

interface Props {
  def: KindDisplay;
}
const { def } = Astro.props;
---

<span class="kind-badge" title={def.desc}>{def.label}</span>

<style>
  .kind-badge {
    display: inline-block;
    font: 600 10.5px/1 var(--font-ui);
    letter-spacing: 0.05em;
    color: var(--color-ink-soft);
    border: 1px solid color-mix(in srgb, var(--color-ink-faint) 70%, var(--color-line));
    border-radius: 3px;
    padding: 3px 6px;
    white-space: nowrap;
  }
</style>
