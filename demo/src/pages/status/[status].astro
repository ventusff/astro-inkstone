---
/** /status/<id>/ — browse by maturity status (only non-empty values prerender); English. */
import FacetPage from '../../components/browse/FacetPage.astro';
import { getWikiUnits } from '../../lib/taxonomy';
import { STATUSES } from '../../content/notes/_meta/taxonomy';

export async function getStaticPaths() {
  const units = await getWikiUnits();
  return STATUSES.map((def) => ({ def, notes: units.filter((u) => u.status === def.id) }))
    .filter((s) => s.notes.length > 0)
    .map((s) => ({ params: { status: s.def.id }, props: s }));
}
---

<FacetPage locale="en" dim="status" {...Astro.props} />
