---
/**
 * Local in-page jump list (.local-toc). Accepts both ToC shapes produced by
 * the two numbering presets — `TocData.items` (chapters) and
 * `TocData.entries` (sections) — so sites never need their own variant.
 *
 *   <LocalToc toc={toc} label="On this page" />           — chapters
 *   <LocalToc toc={toc} label="In this chapter" min={5} /> — sections
 *                                (renders nothing below `min` sections)
 *
 * Labels go through renderTocLabel (inline $TeX$ preserved); the ToC is
 * generated at build time, never hand-written.
 */
import { renderTocLabel } from '../lib/toc';
import type { TocData as ChaptersToc } from '../lib/toc-types';
import type { TocData as SectionsToc } from '../lib/rehype-sections';

interface Props {
  toc: ChaptersToc | SectionsToc;
  label?: string | undefined;
  /** Render nothing below this many sections (0 = always render). */
  min?: number;
}
const { toc, label, min = 0 } = Astro.props;

interface Row {
  id: string;
  num: string;
  label: string;
}
const rows: Row[] =
  'entries' in toc
    ? toc.entries.filter((e) => e.depth === 2).map((e) => ({ id: e.id, num: e.num, label: e.label }))
    : toc.items
        .filter((i) => i.kind === 'entry' && i.depth === 2 && i.num !== '')
        .map((i) => ({ id: i.id, num: i.num, label: i.label }));
---

{
  rows.length >= Math.max(min, 1) && (
    <nav class="local-toc" aria-label={label ?? 'sections'}>
      {label && <div class="label">{label}</div>}
      <ol>
        {rows.map((r) => (
          <li>
            <span class="idx">{r.num}</span>
            <a href={`#${r.id}`}>
              <Fragment set:html={renderTocLabel(r.label)} />
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
