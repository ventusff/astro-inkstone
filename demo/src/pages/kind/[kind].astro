---
/** /kind/<id>/ — browse by note kind (only non-empty values prerender). */
import FacetNav from 'astro-inkstone/components/wiki/FacetNav.astro';
import NoteCard from 'astro-inkstone/components/wiki/NoteCard.astro';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { cardOf, facetBase } from '../../lib/display';
import { getWikiUnits, groupByKind, groupByDomain, tagIndex, type ResolvedNote } from '../../lib/taxonomy';
import { STATUSES, type KindDef } from '../../content/notes/_meta/taxonomy';

export async function getStaticPaths() {
  const units = await getWikiUnits();
  return groupByKind(units).map((g) => ({
    params: { kind: g.def.id },
    props: { def: g.def, notes: g.notes },
  }));
}

interface Props {
  def: KindDef;
  notes: ResolvedNote[];
}
const { def, notes } = Astro.props;

const units = await getWikiUnits();
const kinds = groupByKind(units).map((g) => ({ def: g.def, count: g.notes.length }));
const domains = groupByDomain(units).map((g) => ({ def: g.def, count: g.notes.length }));
const statuses = STATUSES.map((s) => ({ def: s, count: units.filter((u) => u.status === s.id).length })).filter(
  (s) => s.count > 0,
);
const tags = [...tagIndex(units).entries()].slice(0, 10).map(([tag, list]) => ({ tag, count: list.length }));
---

<BrowseLayout title={`${def.label} · ${def.zh}`} description={`${def.desc} (${notes.length} notes)`} crumbs={[{ label: def.label }]}>
  <header class="wb-hero">
    <p class="wb-kicker">By kind <span class="sep">·</span> 按形式</p>
    <h1 class="wb-title">{def.label}<span class="en">{def.zh}</span></h1>
    <p class="wb-lede">{def.desc} — <strong>{notes.length}</strong> notes.</p>
  </header>
  <FacetNav base={facetBase} kinds={kinds} domains={domains} statuses={statuses} tags={tags} active={{ dim: 'kind', value: def.id }} />
  <ul class="wb-grid">
    {notes.map((note) => <NoteCard note={cardOf(note)} />)}
  </ul>
</BrowseLayout>
