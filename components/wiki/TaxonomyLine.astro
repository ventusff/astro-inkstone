---
/**
 * TaxonomyLine — one restrained meta strip at the top of a note page:
 * kind badge · domain chips · status dot · updated date · reading time.
 * Renders nothing when the note carries none of them.
 *
 * Purely presentational: the site resolves registry defs and URLs (e.g. with
 * the `createTaxonomy` helpers from `astro-inkstone/lib/taxonomy`) and passes
 * display-ready values in.
 */
import DomainChip from './DomainChip.astro';
import KindBadge from './KindBadge.astro';
import StatusDot from './StatusDot.astro';
import type { DomainDisplay, KindDisplay, StatusDisplay } from '../../lib/wiki-display.ts';

interface Props {
  kind?: KindDisplay | undefined;
  domains?: DomainDisplay[] | undefined;
  status?: StatusDisplay | undefined;
  /** Pre-formatted display date (e.g. "2026.05"). */
  updated?: string | undefined;
  /** Pre-formatted reading time (e.g. "6 min read"). */
  reading?: string | undefined;
  /** Display strings; pass localized overrides. */
  labels?: { updated?: string | undefined } | undefined;
}
const { kind, domains = [], status, updated, reading, labels = {} } = Astro.props;
const dateLabel = labels.updated ?? 'updated';
const show =
  kind !== undefined || domains.length > 0 || status !== undefined || updated !== undefined || reading !== undefined;
---

{
  show && (
    <div class="taxo-line">
      {kind && <KindBadge def={kind} />}
      {domains.map((d) => (
        <DomainChip def={d} href={d.href} />
      ))}
      {status && <StatusDot def={status} />}
      {updated && (
        <span class="date">
          {dateLabel} {updated}
        </span>
      )}
      {reading && <span class="date">{reading}</span>}
    </div>
  )
}

<style>
  .taxo-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0 0 1.1rem;
  }
  .date {
    font: 500 11px/1 var(--font-ui);
    color: var(--color-ink-faint);
    margin-left: 2px;
  }
</style>
