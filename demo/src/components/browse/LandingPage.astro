---
/**
 * The garden's landing page, in one locale — taxonomy-driven: masthead with
 * counts → facet index → recently updated → one shelf per primary domain →
 * status legend. Everything on it comes from the note collection; adding a
 * note changes this page without touching it. The en and zh routes render
 * this one component with their locale.
 */
import { getCollection } from 'astro:content';
import FacetNav from 'astro-inkstone/components/wiki/FacetNav.astro';
import NoteCard from 'astro-inkstone/components/wiki/NoteCard.astro';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { browseHrefFor, cardOf, facetBaseFor, facetsOf, localized } from '../../lib/display';
import { ENGINE_URL, GITHUB_URL, landingRoute, otherLocale, UI, type Locale } from '../../lib/i18n';
import { getWikiUnits, groupByPrimaryDomain } from '../../lib/taxonomy';
import { STATUSES } from '../../content/notes/_meta/taxonomy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];
const b = t.browse;
const links = browseHrefFor(locale);

const units = await getWikiUnits();
const byId = new Map((await getCollection('notes')).map((e) => [e.id, e]));
const shelves = groupByPrimaryDomain(units);
const recent = units.slice(0, 3);
const facets = facetsOf(units, locale);
const domainCount = new Set(units.flatMap((u) => u.domains)).size;
const card = (note: (typeof units)[number]) => cardOf(note, locale, byId);
---

<BrowseLayout
  title={locale === 'zh' ? '纸与墨的园地' : 'A paper-and-ink garden'}
  description={
    locale === 'zh'
      ? 'astro-inkstone 示范站——一座笔记园地,笔记本身就是这个包的使用手册。'
      : "The astro-inkstone demo — a taxonomy garden whose notes are the package's own manual."
  }
  locale={locale}
  translateRoute={landingRoute(otherLocale(locale))}
>
  <header class="wb-hero">
    <p class="wb-kicker">{b.kicker} <span class="sep">·</span> {b.kickerSub}</p>
    <h1 class="wb-title">{b.title}<span class="en">{b.titleSub}</span></h1>
    <p class="wb-lede">
      {b.lede(units.length, domainCount)}{b.sep}{b.source} <a href={GITHUB_URL}>astro-inkstone</a> ({b.thisPackage}) ·{' '}
      <a href={ENGINE_URL}>astro-inkbrush</a> ({b.theEngine} <code>npm run wiki</code> {b.editsThesePages}){b.stop}
    </p>
  </header>

  <FacetNav
    base={facetBaseFor(locale)}
    kinds={facets.kinds}
    domains={facets.domains}
    statuses={facets.statuses}
    tags={facets.tags}
    labels={facets.labels}
  />

  <section class="wb-shelf" aria-label={b.recent}>
    <div class="wb-shelf-head">
      <h2 class="wb-shelf-title">{b.recent}</h2>
      <span class="wb-shelf-en">{b.recentSub}</span>
    </div>
    <ul class="wb-grid">
      {recent.map((note) => <NoteCard note={card(note)} labels={{ chapters: b.chapters }} />)}
    </ul>
  </section>

  {
    shelves.map(({ def, notes }) => {
      const d = localized(def, locale);
      return (
        <section class="wb-shelf" style={`--shelf-fg:${def.tone.fg}`}>
          <div class="wb-shelf-head">
            <h2 class="wb-shelf-title">{d.label}</h2>
            <span class="wb-shelf-en">{locale === 'zh' ? def.label : def.zh}</span>
            <a class="wb-shelf-count" href={links.domain(def.id)}>
              {b.shelfCount(notes.length)}
            </a>
          </div>
          <p class="wb-shelf-desc">{d.desc}</p>
          <ul class="wb-grid">
            {notes.map((note) => (
              <NoteCard note={card(note)} labels={{ chapters: b.chapters }} />
            ))}
          </ul>
        </section>
      );
    })
  }

  <footer class="wb-legend">
    {
      /* each status links to its /status/<id>/ browse page; a status no
         note carries yet stays plain text (its route does not prerender) */
      STATUSES.map((s) => {
        const d = localized(s, locale);
        return units.some((u) => u.status === s.id) ? (
          <a class="wb-legend-item" href={links.status(s.id)}>
            <span class="dot" style={`background:${s.dot}`} aria-hidden="true" />
            {d.label} — {d.desc}
          </a>
        ) : (
          <span class="wb-legend-item">
            <span class="dot" style={`background:${s.dot}`} aria-hidden="true" />
            {d.label} — {d.desc}
          </span>
        );
      })
    }
    <span class="wb-legend-links">
      <a href={links.all()}>{b.allNotes}</a>
    </span>
  </footer>
</BrowseLayout>
