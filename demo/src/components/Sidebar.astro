---
/**
 * Sidebar — brand and the manual's ToC. The CURRENT page expands into a
 * `ul.sub` of its own section anchors, which the scroll-spy in Base.astro
 * highlights.
 *
 * Chapter and section numbers come from POSITION in book.ts — never typed
 * anywhere, so inserting a page renumbers everything at once.
 */
import { BOOK, PARTS } from '../lib/book';
import { href, localeRoute, UI, type Locale } from '../lib/i18n';
import type { TocData } from '../lib/toc';

interface Props {
  currentRoute: string; // root-relative, e.g. 'design/tokens/' or 'en/design/tokens/'
  locale: Locale;
  /** sections of the page being rendered (expanded under its own row) */
  toc: TocData;
}
const { currentRoute, locale, toc } = Astro.props;
const zh = locale === 'zh';
const t = UI[locale];
const sections = toc.entries.filter((e) => e.depth === 2);
---

<aside class="sidebar" id="site-sidebar">
  {/* the brand is chrome, not the document's title: the ONE h1 on every page
      is the article heading in Base.astro, so this stays a plain div */}
  <a class="brand-link" href={href(zh ? 'zh/' : '')}>
    <div class="brand-title"><span class="glyph" aria-hidden="true">◈</span>astro-<em>inkstone</em></div>
    <div class="subtitle">{t.brandSub}</div>
  </a>

  <nav aria-label="Contents">
    <ul class="toc">
      {
        PARTS.map((part) => (
          <>
            <li class="part-head" data-part={part.key}>
              <span>{zh ? part.zh : part.en}</span>
              <span class="zh">{zh ? part.en : part.zh}</span>
            </li>
            {part.chapters.map((c) => {
              const ci = BOOK.indexOf(c);
              return (
                <>
                  <li class="group">
                    <span class="n">{ci + 1}</span>
                    <a href={href(localeRoute(c.sections[0]!.id, locale))}>{zh ? c.zh : c.en}</a>
                    <span class="zh">{zh ? c.en : c.zh}</span>
                  </li>
                  {c.sections.map((s, si) => {
                    const route = localeRoute(s.id, locale);
                    const num = `${ci + 1}.${si + 1}`;
                    const label = zh ? s.zh : s.en;
                    return route === currentRoute ? (
                      <li>
                        {/* visual state alone is not enough for the current
                            page — screen readers rely on aria-current */}
                        <span class="here" aria-current="page">
                          <span class="num-col">{num}</span>
                          {label}
                        </span>
                        {sections.length > 0 && (
                          <ul class="sub">
                            {sections.map((e) => (
                              <li>
                                <a href={`#${e.id}`}>
                                  <span class="idx">{e.num}</span>
                                  {e.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ) : (
                      <li>
                        <a href={href(route)}>
                          <span class="num-col">{num}</span>
                          {label}
                        </a>
                      </li>
                    );
                  })}
                </>
              );
            })}
          </>
        ))
      }
    </ul>
  </nav>
</aside>
