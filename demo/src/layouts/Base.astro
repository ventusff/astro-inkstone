---
/**
 * Page shell: nav bar, search palette, lightbox and the site-wide scripts.
 * NoteLayout and BrowseLayout wrap their own column structure around this.
 *
 * Parts of the DOM here are astro-inkbrush's contract, not a styling choice:
 *
 *   .site-nav + the two        see components/Breadcrumb.astro
 *   [data-inkbrush-slot]
 *   main.note-main > .col      NoteLayout — the comment section mounts there
 *
 * A consuming site can copy this shell wholesale as a starting point — it is
 * deliberately ordinary Astro.
 */
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import SearchPalette from '../components/SearchPalette.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { UI, type Locale } from '../lib/i18n';

interface Crumb {
  label: string;
  route?: string | undefined;
}

interface Props {
  title: string;
  description?: string | undefined;
  /** UI-chrome language (note pages follow the note's locale) */
  locale?: Locale;
  htmlLang?: string;
  crumbs?: Crumb[];
  /** counterpart route in the other locale; omitted on pages with no twin */
  translateRoute?: string | undefined;
  /**
   * Collection entry id, when this page is editable through the CMS. The
   * <meta name="inkbrush-note"> tags are editing metadata — emitted in WIKI
   * mode only, so the published bundle never carries them.
   */
  noteId?: string | undefined;
}
const {
  title,
  description,
  locale = 'en',
  htmlLang = locale === 'zh' ? 'zh-CN' : 'en',
  crumbs = [],
  translateRoute,
  noteId,
} = Astro.props;

// The CMS resolves a note's URL from its id with this template; the id↔route
// identity (route = `${base}${id}/`) is what makes the language-switch jump
// work inside inkbrush's own locale registry.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const noteUrlTemplate = `${base}{id}/`;
const wikiMode = Boolean(import.meta.env.WIKI ?? process.env.WIKI);

const t = UI[locale];

/** Accessible names for the shell's own widgets. */
const A11Y: Record<Locale, { lightbox: string; close: string }> = {
  zh: { lightbox: '图片查看器', close: '关闭' },
  en: { lightbox: 'Image viewer', close: 'Close' },
};
const a11y = A11Y[locale];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='13'>◈</text></svg>"
    />
    <title>{title} · astro-inkstone</title>
    {wikiMode && noteId && <meta name="inkbrush-note" content={noteId} />}
    {wikiMode && noteId && <meta name="inkbrush-note-url" content={noteUrlTemplate} />}
    <ThemeInit />
  </head>
  <body>
    <Breadcrumb locale={locale} crumbs={crumbs} translateRoute={translateRoute} />
    <slot />

    <dialog class="lightbox" aria-label={a11y.lightbox}>
      <button class="lb-close" type="button" aria-label={a11y.close}>
        <span aria-hidden="true">×</span>
      </button>
      <img alt="" />
      <div class="cap"></div>
    </dialog>
    <SearchPalette locale={locale} />

    <script>
      // ---- keep the sidebar in step with the page ------------------------
      // On load the sidebar scrolls itself so the current row sits in view;
      // while reading, the section under the reading line (30% viewport) is
      // the highlighted one, and that link is kept visible in the sidebar.
      const sidebar = document.querySelector<HTMLElement>('.sidebar');
      const here = document.querySelector<HTMLElement>('.toc .here');
      if (sidebar && here) {
        const sb = sidebar.getBoundingClientRect();
        const hr = here.getBoundingClientRect();
        sidebar.scrollTop += hr.top - sb.top - sidebar.clientHeight * 0.33;
      }
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc ul.sub a[href^="#"]')];
      // href attribute, not `.hash`: `.hash` comes back percent-encoded, and
      // heading ids may be Chinese — getElementById would find nothing
      const byId = new Map(links.map((a) => [(a.getAttribute('href') ?? '').slice(1), a]));
      if (byId.size > 0 && sidebar) {
        let active: HTMLAnchorElement | null = null;
        const targets = [...byId.keys()]
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);
        const pick = () => {
          const line = window.innerHeight * 0.3;
          let cur: HTMLElement | null = null;
          for (const el of targets) {
            if (el.getBoundingClientRect().top <= line) cur = el;
            else break;
          }
          if (!cur && targets.length) cur = targets[0]!;
          const link = cur ? byId.get(cur.id) : undefined;
          if (!link || link === active) return;
          active?.classList.remove('active');
          link.classList.add('active');
          active = link;
          const lr = link.getBoundingClientRect();
          const sr = sidebar.getBoundingClientRect();
          if (lr.top < sr.top + 24 || lr.bottom > sr.bottom - 24) {
            sidebar.scrollTop += lr.top - sr.top - sidebar.clientHeight * 0.4;
          }
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            pick();
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        pick();
      }

      // ---- figure lightbox ------------------------------------------------
      const box = document.querySelector<HTMLDialogElement>('dialog.lightbox');
      if (box) {
        const img = box.querySelector('img') as HTMLImageElement;
        const cap = box.querySelector('.cap') as HTMLElement;
        for (const btn of document.querySelectorAll<HTMLButtonElement>('.figure button.zoom')) {
          btn.addEventListener('click', () => {
            img.src = btn.dataset['full'] ?? '';
            img.alt = btn.dataset['alt'] ?? '';
            cap.textContent = btn.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
            box.showModal();
          });
        }
        // an explicit control, so the only ways out are not "click somewhere"
        // and Esc — both invisible to anyone reading the dialog by name
        box.querySelector<HTMLButtonElement>('.lb-close')?.addEventListener('click', () => box.close());
        box.addEventListener('click', (e) => {
          if (!(e.target as HTMLElement).closest('.lb-close')) box.close();
        });
      }

      // ---- code frame: copy button (markup from the package's code-frame
      // transformer; the click handler is the site's — event delegation) -----
      document.addEventListener('click', (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('.code-copy');
        if (!btn) return;
        const pre = btn.closest('.code-frame')?.querySelector('pre');
        if (!pre) return;
        void navigator.clipboard.writeText(pre.innerText).then(() => {
          btn.classList.add('is-done');
          setTimeout(() => btn.classList.remove('is-done'), 1600);
        });
      });

      // ---- mermaid: only pages that carry a .mermaid block pay for the
      // chunk (the package's rehype-mermaid-client leaves `pre.mermaid`
      // placeholders); re-rendered when the theme flips ----------------------
      {
        const blocks = [...document.querySelectorAll<HTMLElement>('pre.mermaid')];
        if (blocks.length > 0) {
          const sources = blocks.map((b) => b.textContent ?? '');
          const renderAll = async (): Promise<void> => {
            const { default: mermaid } = await import('mermaid');
            const dark = document.documentElement.dataset['theme'] === 'dark';
            blocks.forEach((b, i) => {
              b.textContent = sources[i] ?? '';
              b.removeAttribute('data-processed');
            });
            mermaid.initialize({
              startOnLoad: false,
              theme: dark ? 'dark' : 'neutral',
              fontFamily: 'var(--font-ui)',
            });
            await mermaid.run({ nodes: blocks });
          };
          void renderAll();
          for (const btn of document.querySelectorAll('.theme-toggle')) {
            btn.addEventListener('click', () => void renderAll());
          }
        }
      }
    </script>

    <script>
      // Interactive demos: the package's DemoMount renders the markup; the
      // site owns the loader (src/lib/demo-loader.ts). Pages without a
      // [data-demo] mount load nothing beyond this call.
      import { mountAllDemos } from '../lib/demo-loader';
      mountAllDemos();
    </script>
  </body>
</html>
