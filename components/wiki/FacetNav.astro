---
/**
 * FacetNav — faceted browse index: rows of value pills (with counts) for
 * kind / domain / status / tag (the status row renders only when the site
 * passes it, i.e. when it routes /status/…). Rendered on every browse page
 * (the current facet value is highlighted via aria-current); pure static
 * links, zero JS.
 *
 * Purely presentational: the site computes the rows (e.g. with the
 * `createTaxonomy` helpers from `astro-inkstone/lib/taxonomy`, bound to its
 * own registry) and passes them in. Tags are typically capped upstream
 * (e.g. top 10), with the rest reachable via the "all" page.
 */
import { normalizeBase } from '../../lib/base.ts';
import type { KindDisplay, Tone } from '../../lib/wiki-display.ts';

/** a facet value: a kind, or a domain with its tone */
export interface FacetDef extends KindDisplay {
  tone?: Tone | undefined;
}

interface Props {
  kinds: { def: FacetDef; count: number }[];
  domains: { def: FacetDef; count: number }[];
  /** maturity statuses, for sites that route /status/<id>/; omitted = no row */
  statuses?: { def: FacetDef; count: number }[] | undefined;
  tags: { tag: string; count: number }[];
  /** Mount prefix for browse routes, e.g. "/wiki" → "/wiki/kind/<id>/";
   *  any spelling ('/wiki', 'wiki/', …) — it is normalized here. */
  base: string;
  active?: { dim: 'kind' | 'domain' | 'status' | 'tag' | 'all'; value?: string | undefined } | undefined;
  /** Row labels; pass localized strings to override. */
  labels?:
    | {
        kind?: string | undefined;
        domain?: string | undefined;
        status?: string | undefined;
        tag?: string | undefined;
        all?: string | undefined;
        aria?: string | undefined;
      }
    | undefined;
}
const { kinds, domains, statuses = [], tags, base, active, labels = {} } = Astro.props;
const root = normalizeBase(base);
/** browse route for one facet value; the value is data, so it is URL-encoded */
const facetHref = (dim: string, value: string): string =>
  `${root}/${dim}/${encodeURIComponent(value)}/`;
const label = {
  kind: labels.kind ?? 'Kind',
  domain: labels.domain ?? 'Domain',
  status: labels.status ?? 'Status',
  tag: labels.tag ?? 'Tags',
  all: labels.all ?? 'All →',
  aria: labels.aria ?? 'Browse index',
};

const isActive = (dim: string, value: string): boolean =>
  active?.dim === dim && active.value === value;
---

<nav class="facet-nav" aria-label={label.aria}>
  <div class="row">
    <span class="dim">{label.kind}</span>
    {kinds.map(({ def, count }) => (
      <a
        class="pill"
        href={facetHref('kind', def.id)}
        aria-current={isActive('kind', def.id) ? 'page' : undefined}
      >
        {def.label} <b>{count}</b>
      </a>
    ))}
  </div>
  <div class="row">
    <span class="dim">{label.domain}</span>
    {domains.map(({ def, count }) => (
      <a
        class="pill"
        href={facetHref('domain', def.id)}
        aria-current={isActive('domain', def.id) ? 'page' : undefined}
        style={def.tone ? `--pill-fg:${def.tone.fg}` : undefined}
      >
        {def.label} <b>{count}</b>
      </a>
    ))}
  </div>
  {
    statuses.length > 0 && (
      <div class="row">
        <span class="dim">{label.status}</span>
        {statuses.map(({ def, count }) => (
          <a
            class="pill"
            href={facetHref('status', def.id)}
            aria-current={isActive('status', def.id) ? 'page' : undefined}
          >
            {def.label} <b>{count}</b>
          </a>
        ))}
      </div>
    )
  }
  <div class="row">
    <span class="dim">{label.tag}</span>
    {tags.map(({ tag, count }) => (
      <a
        class="pill"
        href={facetHref('tag', tag)}
        aria-current={isActive('tag', tag) ? 'page' : undefined}
      >
        {tag} <b>{count}</b>
      </a>
    ))}
    <a class="pill more" href={`${root}/all/`} aria-current={active?.dim === 'all' ? 'page' : undefined}>
      {label.all}
    </a>
  </div>
</nav>

<style>
  .facet-nav {
    margin: 1.4rem 0 0;
    padding: 14px 16px;
    background: color-mix(in srgb, var(--wb-bg-card) 55%, transparent);
    border: 1px solid var(--wb-border-soft);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .dim {
    font: 600 11px/1 var(--wb-sans);
    letter-spacing: 0.12em;
    color: var(--wb-text-muted);
    width: 42px;
    flex-shrink: 0;
  }
  .pill {
    font: 500 12px/1 var(--wb-sans);
    color: var(--pill-fg, var(--wb-text-soft));
    border: 1px solid var(--wb-border);
    border-radius: 999px;
    padding: 4.5px 10px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .pill b {
    font-weight: 600;
    color: var(--wb-text-muted);
    margin-left: 2px;
  }
  .pill:hover {
    border-color: var(--wb-rule);
    background: color-mix(in srgb, var(--wb-bg) 45%, transparent);
  }
  .pill[aria-current='page'] {
    background: var(--wb-text);
    border-color: var(--wb-text);
    color: var(--wb-bg);
  }
  .pill[aria-current='page'] b {
    color: color-mix(in srgb, var(--wb-bg) 78%, var(--wb-text));
  }
  .more {
    color: var(--wb-wine);
  }
  /* registry tones are tuned for the light ground; on night the pill takes a
     lightened mix of its tone instead */
  :global(:root[data-theme='dark']) .pill[style] {
    color: color-mix(in srgb, var(--pill-fg) 45%, var(--wb-text));
  }
  :global(:root[data-theme='dark']) .pill[aria-current='page'][style] {
    color: var(--wb-bg);
  }
</style>
