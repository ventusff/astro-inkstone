---
/**
 * Domain chip — colored by the registry's tone pair. Purely presentational:
 * the site resolves the def from its registry and passes it in; pass `href`
 * to render it as a link (e.g. to the domain's browse page).
 */
export interface DomainChipDef {
  id: string;
  label: string;
  desc?: string | undefined;
  tone: { bg: string; fg: string };
}

interface Props {
  def: DomainChipDef;
  href?: string | undefined;
}
const { def, href } = Astro.props;
const style = `--chip-bg:${def.tone.bg}; --chip-fg:${def.tone.fg};`;
---

{
  href ? (
    <a class="domain-chip" href={href} style={style} title={def.desc}>
      {def.label}
    </a>
  ) : (
    <span class="domain-chip" style={style} title={def.desc}>
      {def.label}
    </span>
  )
}

<style>
  .domain-chip {
    display: inline-block;
    font: 500 10.5px/1 var(--wb-sans, sans-serif);
    letter-spacing: 0.04em;
    color: var(--chip-fg);
    background: var(--chip-bg);
    border-radius: 999px;
    padding: 3.5px 8px;
    text-decoration: none;
    white-space: nowrap;
  }
  a.domain-chip:hover {
    filter: saturate(1.4) brightness(0.96);
  }
  /* Dark theme: registry tones are tuned for light backgrounds — derive a
     night variant from the fg color so every host page stays consistent. */
  :global(:root[data-theme='dark']) .domain-chip {
    background: color-mix(in srgb, var(--chip-fg) 20%, transparent);
    color: color-mix(in srgb, var(--chip-fg) 45%, var(--wb-text, #e6e4dc));
  }
</style>
