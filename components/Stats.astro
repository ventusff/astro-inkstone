---
/**
 * Stat row (landing heroes): a value and its label per tile. The row is a
 * description list — each tile pairs the label (dt) with its value (dd);
 * base.css renders the value above the label.
 */
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="stats">
  {
    items.map((s) => (
      <div class="stat">
        <dt class="k">{s.label}</dt>
        <dd class="v">{s.value}</dd>
      </div>
    ))
  }
</dl>
