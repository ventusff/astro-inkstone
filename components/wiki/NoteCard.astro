---
/**
 * NoteCard — note card for browse pages: title / description / kind badge /
 * domain chips / status dot / source line / date / locale mirrors / chapter
 * count for collections.
 *
 * Purely presentational: the site resolves registry defs and URLs (e.g. with
 * the `createTaxonomy` helpers from `astro-inkstone/lib/taxonomy`) and passes
 * a display-ready object in.
 */
import DomainChip from './DomainChip.astro';
import KindBadge from './KindBadge.astro';
import StatusDot from './StatusDot.astro';

export interface NoteCardData {
  /** Canonical note id — emitted on data-* attributes for styling/filter hooks. */
  id: string;
  href: string;
  title: string;
  description?: string | undefined;
  kind?: { id: string; label: string; desc?: string | undefined } | undefined;
  domains: {
    id: string;
    label: string;
    desc?: string | undefined;
    tone: { bg: string; fg: string };
    href?: string | undefined;
  }[];
  status?: { id: string; label: string; desc?: string | undefined; dot: string } | undefined;
  /** Pre-formatted display date (e.g. "2026.05"). */
  updated?: string | undefined;
  /** Chapter count, for multi-chapter collection notes. */
  chapterCount?: number | undefined;
  /** Other-locale mirrors of this note, e.g. [{ label: 'EN', href: '/en/note/' }]. */
  mirrors?: { label: string; href: string }[] | undefined;
  /** Pre-joined source line (paper title · venue · arXiv id, …). */
  sourceLine?: string | undefined;
}

interface Props {
  note: NoteCardData;
  /** Display strings; pass localized overrides. */
  labels?: { chapters?: ((n: number) => string) | undefined } | undefined;
}
const { note, labels = {} } = Astro.props;
const chaptersLabel = labels.chapters ?? ((n: number) => `${n} chapters`);
---

<li
  class="note-card"
  data-kind={note.kind?.id}
  data-domains={note.domains.map((d) => d.id).join(' ')}
  data-status={note.status?.id}
>
  <div class="head">
    {note.kind && <KindBadge def={note.kind} />}
    {note.chapterCount !== undefined && <span class="chapters">{chaptersLabel(note.chapterCount)}</span>}
    {note.updated && <span class="date">{note.updated}</span>}
  </div>
  <a class="title" href={note.href}>{note.title}</a>
  <p class="desc">{note.description}</p>
  <div class="meta">
    {note.domains.map((dom) => <DomainChip def={dom} href={dom.href} />)}
    {note.status && <StatusDot def={note.status} />}
    {(note.mirrors ?? []).map((m) => (
      <a class="mirror" href={m.href}>{m.label}</a>
    ))}
  </div>
  {note.sourceLine && <p class="source">{note.sourceLine}</p>}
</li>

<style>
  .note-card {
    display: flex;
    flex-direction: column;
    gap: 7px;
    background: var(--wb-bg-card, #f6f0dc);
    border: 1px solid var(--wb-border-soft, #e2d9c3);
    border-radius: 8px;
    padding: 16px 18px;
    transition: border-color 0.15s ease;
  }
  .note-card:hover {
    border-color: var(--wb-rule, #b8a98a);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chapters {
    font: 500 11px/1 var(--wb-sans, sans-serif);
    color: var(--wb-text-dim, #6e6453);
  }
  .date {
    margin-left: auto;
    font: 500 11px/1 var(--wb-sans, sans-serif);
    color: var(--wb-text-muted, #968b73);
  }

  .title {
    font-size: 17.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--wb-text, #2b2622);
    text-decoration: none;
  }
  .title:hover {
    color: var(--wb-wine, #7d3a3a);
  }

  .desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--wb-text-soft, #4a4137);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .mirror {
    font: 600 10px/1 var(--wb-sans, sans-serif);
    letter-spacing: 0.06em;
    color: var(--wb-text-dim, #6e6453);
    border: 1px solid var(--wb-border, #d6cbb1);
    border-radius: 3px;
    padding: 3px 5px;
    text-decoration: none;
  }
  .mirror:hover {
    color: var(--wb-wine, #7d3a3a);
    border-color: currentColor;
  }

  .source {
    margin: 0;
    font: 400 11.5px/1.5 var(--wb-sans, sans-serif);
    color: var(--wb-text-muted, #968b73);
  }
</style>
