---
/**
 * Domain chip — colored by the registry's tone pair. Purely presentational:
 * the site resolves the def from its registry and passes it in. With a link
 * target it renders as a link (e.g. to the domain's browse page): the
 * `href` prop when given, else the def's own `href`.
 */
import type { DomainDisplay } from '../../lib/wiki-display.ts';

interface Props {
  def: DomainDisplay;
  /** overrides `def.href` */
  href?: string | undefined;
}
const { def, href: hrefProp } = Astro.props;
const href = hrefProp ?? def.href;
const style = `--chip-bg:${def.tone.bg}; --chip-fg:${def.tone.fg};`;
---

{
  href ? (
    <a class="domain-chip" href={href} style={style} title={def.desc}>
      {def.label}
    </a>
  ) : (
    <span class="domain-chip" style={style} title={def.desc}>
      {def.label}
    </span>
  )
}

<style>
  .domain-chip {
    display: inline-block;
    font: 500 10.5px/1 var(--font-ui);
    letter-spacing: 0.04em;
    color: var(--chip-fg);
    background: var(--chip-bg);
    border-radius: 999px;
    padding: 3.5px 8px;
    text-decoration: none;
    white-space: nowrap;
  }
  a.domain-chip:hover {
    filter: saturate(1.4) brightness(0.96);
  }
  /* registry tones are tuned for the light ground; on night the chip takes a
     translucent wash of its tone and a lightened mix of it as text */
  :global(:root[data-theme='dark']) .domain-chip {
    background: color-mix(in srgb, var(--chip-fg) 20%, transparent);
    color: color-mix(in srgb, var(--chip-fg) 45%, var(--color-ink));
  }
</style>
