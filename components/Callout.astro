---
/**
 * Callout — the same markup the `> [!tip]` quote syntax renders
 * (lib/remark-callouts.ts): an <aside class="callout …"> with a title line.
 * Five variants: note (default), intuition, warn, system, abstract. `title`
 * replaces the variant's default label; `labels` supplies localized defaults
 * (the same shape as siteMarkdown's `calloutLabels`). The default labels are
 * remark-callouts' CALLOUT_LABELS — one table for both spellings.
 */
import { CALLOUT_LABELS, type CalloutVariant } from '../lib/remark-callouts.ts';

interface Props {
  variant?: CalloutVariant | undefined;
  title?: string | undefined;
  labels?: Partial<Record<CalloutVariant, string>> | undefined;
}
const { variant = 'note', title, labels = {} } = Astro.props;

const heading = title ?? labels[variant] ?? CALLOUT_LABELS[variant];
---

{/* the aria-label names the complementary landmark after its title, so
    repeated callouts are distinguishable in a landmark list */}
<aside class:list={['callout', variant !== 'note' && variant]} aria-label={heading}>
  <div class="callout-title">{heading}</div>
  <slot />
</aside>
