---
/**
 * Paper card — the survey workhorse.
 *
 *   <PaperCard
 *     alias="Transformer" full="Attention Is All You Need"
 *     tags={[{ label: 'NeurIPS 2017' }]}
 *     meta="Vaswani, Shazeer, Parmar … · Google Brain / Google Research"
 *     links={[{ label: 'arXiv:1706.03762', href: 'https://arxiv.org/abs/1706.03762' }]}
 *     id="transformer-card">
 *     <Fragment slot="pain">What earlier methods struggled with… (markdown works)</Fragment>
 *     **Key idea**: …body text (markdown works)
 *     <Fragment slot="diff">Why this paper changed the follow-up landscape.</Fragment>
 *   </PaperCard>
 *
 * pain/diff are SLOTS (not props) so markdown & math keep working inside.
 * alias / full / meta may contain inline `$…$` (e.g. "$\alpha$-Net"),
 * rendered at build time; everything else is escaped.
 */
import type { ChipVariant } from './Chip.astro';
import { renderTocLabel } from '../lib/toc.ts';

export interface PaperTag {
  label: string;
  variant?: ChipVariant | undefined;
  /** custom category color (e.g. one tone per method family) */
  tone?: { bg: string; fg: string } | undefined;
}
export interface PaperLink {
  label: string;
  href: string;
}
interface Props {
  alias: string;
  full?: string | undefined;
  meta?: string | undefined;
  tags?: PaperTag[] | undefined;
  links?: PaperLink[] | undefined;
  id?: string | undefined;
}
const { alias, full, meta, tags = [], links = [], id } = Astro.props;
---

<article class="paper" id={id}>
  <div class="paper-head">
    <span class="alias"><Fragment set:html={renderTocLabel(alias)} /></span>
    {full && <span class="full">— <Fragment set:html={renderTocLabel(full)} /></span>}
  </div>
  {
    (tags.length > 0 || meta !== undefined || links.length > 0) && (
      <div class="paper-meta">
        {tags.map((t) => (
          <span
            class:list={['tag', t.variant]}
            style={t.tone ? `background:${t.tone.bg};color:${t.tone.fg};` : undefined}
          >
            {t.label}
          </span>
        ))}
        {meta !== undefined && <Fragment set:html={renderTocLabel(meta)} />}
        {links.map((l, i) => (
          <>
            {/* a link takes a separator only when something precedes it */}
            {(i > 0 || meta !== undefined || tags.length > 0) && ' · '}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </div>
    )
  }
  {
    Astro.slots.has('pain') && (
      <div class="pain">
        <slot name="pain" />
      </div>
    )
  }
  <slot />
  {
    Astro.slots.has('diff') && (
      <div class="diff">
        <slot name="diff" />
      </div>
    )
  }
</article>
