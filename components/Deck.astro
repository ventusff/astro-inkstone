---
/**
 * A slide deck made of the note it wraps. Put the note's rendered content
 * inside; a thematic break (`---` on a line of its own, a blank line before
 * it) ends a slide. The content stays the note's ordinary blocks, so in-place
 * editing, wikilinks and every component work inside a slide (lib/deck.ts).
 *
 *   <Deck><Content /></Deck>
 *
 * The page reads it as a stack of 16:9 slides; "Present" shows one slide at a
 * time over the whole screen, from the slide in view, and P opens the
 * presenter view (the slide, what the next click shows, the slide's notes, a
 * clock and the pace against the deck's time plan) in a second window.
 * "Print or PDF" prints the deck one page per click. Markers shape a slide
 * from inside it, each a block of its own: `<Layout name="…" />` (its
 * layout), `<Column />`, `<Build />`, `<Stretch />` and `<Time minutes={…} />`
 * (its planned time) (Layout.astro, Column.astro, Build.astro, Stretch.astro,
 * Time.astro). Labels default to the page language's words
 * (lib/component-words.ts).
 */
import '../styles/deck.css';
import { type ComponentWords, componentWords } from '../lib/component-words.ts';

interface Props {
  locale?: string | undefined;
  labels?: Partial<ComponentWords['deck']> | undefined;
}
const words = { ...componentWords(Astro.props.locale ?? Astro.currentLocale).deck, ...Astro.props.labels };
const { deck: deckLabel, ...clientWords } = words;
---

<script>
  // first in the component: the deck mounts before the components on its slides
  import { mountDecks } from '../lib/deck.ts';
  mountDecks();
  document.addEventListener('astro:page-load', () => mountDecks());
</script>

<div class="deck" data-deck data-words={JSON.stringify(clientWords)} role="region" aria-label={deckLabel}>
  <div class="deck-bar">
    <button type="button" class="deck-present" data-deck-present>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z"></path></svg>
      {words.present}
    </button>
    <span class="deck-planned" data-deck-planned></span>
    <button type="button" class="deck-export" data-deck-export>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6V2.5h7V6M4.5 11.5h-2v-5h11v5h-2M4.5 9.5h7v4h-7z"></path></svg>
      {words.exportPdf}
    </button>
  </div>
  <div class="deck-slides" data-deck-slides><slot /></div>
  <div class="deck-controls">
    <button type="button" data-deck-prev aria-label={words.previous}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3 5.5 8l5 5"></path></svg>
    </button>
    <span class="deck-position" data-deck-position aria-live="polite"></span>
    <button type="button" data-deck-next aria-label={words.next}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5.5 3 5 5-5 5"></path></svg>
    </button>
    <button type="button" data-deck-overview aria-label={words.overview} title={`${words.overview} (O)`}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 2.5h4v4h-4zM9.5 2.5h4v4h-4zM2.5 9.5h4v4h-4zM9.5 9.5h4v4h-4z"></path></svg>
    </button>
    <button type="button" data-deck-presenter-open aria-label={words.presenter} title={`${words.presenter} (P)`}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3.5h9v7h-9zM12.5 3.5h2M12.5 6h2M12.5 8.5h2M4 13.5h4"></path></svg>
    </button>
    <button type="button" data-deck-exit>{words.exit}</button>
  </div>
  <div class="deck-presenter" data-deck-presenter-panel>
    <div class="deck-presenter-next" role="group" aria-label={words.upNext}>
      <p class="deck-presenter-label">{words.upNext}</p>
      <div class="deck-presenter-view" data-deck-next-view inert></div>
    </div>
    <div class="deck-presenter-notes" role="group" aria-label={words.notes}>
      <p class="deck-presenter-label">{words.notes}</p>
      <div class="deck-presenter-text" data-deck-notes></div>
    </div>
    <p class="deck-presenter-pace" data-deck-pace></p>
    <div class="deck-presenter-clock">
      <span class="deck-presenter-elapsed" data-deck-elapsed>0:00</span>
      <span class="deck-presenter-time" data-deck-time></span>
      <button type="button" data-deck-clock-restart>{words.restartClock}</button>
    </div>
  </div>
  <div class="deck-progress" data-deck-progress></div>
</div>

